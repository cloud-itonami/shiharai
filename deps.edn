{:paths ["src"]
 ;; Frontend deps (shadow-cljs :cljs alias). appkit transitively pulls
 ;; kotoba-ui → liquid-glass-ui → shitsuke — same convention as
 ;; orgs/kotoba-lang/murakumo-studio/deps.edn (local/root checkouts inside
 ;; the west superproject). Two levels up, because this repo sits in a
 ;; DIFFERENT org directory than appkit: orgs/cloud-itonami/shiharai ->
 ;; orgs/ -> orgs/kotoba-lang/appkit. murakumo-studio uses one level because it
 ;; is already inside orgs/kotoba-lang/; copying its "../appkit" across orgs is
 ;; what produced the three-level path this replaces.
 :aliases
 {:cljs
  {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.20"}
                reagent/reagent {:mvn/version "1.2.0"}
                io.github.kotoba-lang/appkit {:local/root "../../kotoba-lang/appkit"}}}}}
