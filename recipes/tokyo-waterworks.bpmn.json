{
  "id": "shiharai-tokyo-waterworks-v1",
  "name": "Tokyo Waterworks credit-card payment",
  "version": 1,
  "variables": {
    "billId": { "type": "string" },
    "payUrl": { "type": "string" },
    "expectedAmountJpy": { "type": "integer" },
    "requesterDid": { "type": "string" }
  },
  "flow": [
    { "id": "start", "type": "startEvent", "next": "open" },
    { "id": "open",        "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.sessionOpen", "params": { "target": "local" }, "resultAs": "session", "next": "goto" },
    { "id": "goto",        "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.goto", "params": { "sessionId": "{{session.sessionId}}", "url": "{{payUrl}}" }, "next": "fillCust" },
    { "id": "fillCust",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[name*='customer']", "valueRef": "vault://shiharai/tokyo-waterworks/customerNumber" }, "next": "fillPass" },
    { "id": "fillPass",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[type='password']", "valueRef": "vault://shiharai/tokyo-waterworks/password" }, "next": "login" },
    { "id": "login",       "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "button:has-text('ログイン')" }, "next": "waitHome" },
    { "id": "waitHome",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.waitFor", "params": { "sessionId": "{{session.sessionId}}", "state": "networkidle" }, "next": "selCard" },
    { "id": "selCard",     "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "label:has-text('クレジットカード')" }, "next": "next1" },
    { "id": "next1",       "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "button:has-text('次へ')" }, "next": "scrape" },
    { "id": "scrape",      "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.scrape", "params": { "sessionId": "{{session.sessionId}}", "selector": "[class*='amount']", "parse": "jpy" }, "resultAs": "scraped", "next": "check" },
    { "id": "check",       "type": "exclusiveGateway", "condition": "{{scraped.value}} == {{expectedAmountJpy}}", "then": "snapshot", "else": "abortAmount" },
    { "id": "snapshot",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.snapshot", "params": { "sessionId": "{{session.sessionId}}" }, "resultAs": "snap", "next": "approve" },
    { "id": "approve",     "type": "messageIntermediateCatchEvent", "messageName": "approved", "timeout": "PT10M", "onTimeout": "abortTimeout", "next": "commit" },
    { "id": "commit",      "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "button:has-text('確定')" }, "next": "waitReceipt" },
    { "id": "waitReceipt", "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.waitFor", "params": { "sessionId": "{{session.sessionId}}", "selector": "[class*='receipt']", "timeout": 30000 }, "next": "receipt" },
    { "id": "receipt",     "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.scrape", "params": { "sessionId": "{{session.sessionId}}", "selector": "[class*='receipt']", "parse": "text" }, "resultAs": "txId", "next": "close" },
    { "id": "close",       "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.sessionClose", "params": { "sessionId": "{{session.sessionId}}" }, "next": "end" },
    { "id": "end",         "type": "endEvent" },
    { "id": "abortAmount", "type": "errorEndEvent", "errorCode": "amount-mismatch" },
    { "id": "abortTimeout","type": "errorEndEvent", "errorCode": "approval-timeout" }
  ]
}
