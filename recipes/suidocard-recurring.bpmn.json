{
  "id": "shiharai-tokyo-waterworks-recurring-v1",
  "name": "Tokyo Waterworks — クレジットカード継続払 registration",
  "version": 1,
  "variables": {
    "recurringId": { "type": "string" },
    "customerNumber": { "type": "string" },
    "payMethod": { "type": "string", "default": "credit-card" }
  },
  "flow": [
    { "id": "start",    "type": "startEvent", "next": "open" },
    { "id": "open",     "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.sessionOpen", "params": { "target": "local" }, "resultAs": "session", "next": "goto" },
    { "id": "goto",     "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.goto", "params": { "sessionId": "{{session.sessionId}}", "url": "https://www.waterworks.metro.tokyo.lg.jp/tetsuduki/ryokin/credit.html" }, "next": "apply" },
    { "id": "apply",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "a:has-text('お申込み')" }, "next": "fillCust" },
    { "id": "fillCust", "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[name*='customer']", "value": "{{customerNumber}}" }, "next": "next1" },
    { "id": "next1",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "button:has-text('次へ')" }, "next": "fillCard" },
    { "id": "fillCard", "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[name*='card_number']", "valueRef": "1password://Personal/Tokyo-Waterworks-Card/number" }, "next": "fillExp" },
    { "id": "fillExp",  "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[name*='expiry']", "valueRef": "1password://Personal/Tokyo-Waterworks-Card/expiry" }, "next": "fillCvc" },
    { "id": "fillCvc",  "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.fill", "params": { "sessionId": "{{session.sessionId}}", "selector": "input[name*='cvc']", "valueRef": "1password://Personal/Tokyo-Waterworks-Card/cvc" }, "next": "snapshot" },
    { "id": "snapshot", "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.snapshot", "params": { "sessionId": "{{session.sessionId}}" }, "next": "approve" },
    { "id": "approve",  "type": "messageIntermediateCatchEvent", "messageName": "approved", "timeout": "PT10M", "onTimeout": "abortTimeout", "next": "commit" },
    { "id": "commit",   "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.click", "params": { "sessionId": "{{session.sessionId}}", "selector": "button:has-text('登録')" }, "next": "close" },
    { "id": "close",    "type": "serviceTask", "nsid": "com.etzhayyim.apps.playwright.sessionClose", "params": { "sessionId": "{{session.sessionId}}" }, "next": "end" },
    { "id": "end",      "type": "endEvent" },
    { "id": "abortTimeout", "type": "errorEndEvent", "errorCode": "approval-timeout" }
  ]
}
